{
  "name": "dsh-zegao-ios",
  "version": "0.1.0",
  "description": "择稿 iOS：Fish Pocket 官方网页版会话选稿、编辑与文件分享",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.4"
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node scripts/test-engine-build.mjs && node --test test/*.test.mjs",
    "pack:plugin": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.4",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.4",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
